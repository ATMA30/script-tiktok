# ═══════════════════════════════════════════════════════════════════════════
#  Usine à vidéos — true crime / faits divers
#  Copie ce fichier en .env et renseigne au minimum GEMINI_API_KEY.
#  Valeurs = défauts du code (générées depuis les os.getenv réellement lus).
#  Booléens : 1 = activé, 0 = désactivé.
# ═══════════════════════════════════════════════════════════════════════════

# ── Clés ─────────────────────────────────────────────────────────────────────
# Obligatoire : cerveau, TTS, Imagen, contrôle NSFW des images.
# Sans elle, aucune image venue du web n'est acceptée.
GEMINI_API_KEY=
# Optionnelles : banques d'images stock (utilisées seulement si ALLOW_STOCK_FALLBACKS=1)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Étape 1 : voix (2_generate_audio.py) ─────────────────────────────────────
# Genre par défaut si script.json ne fixe pas narrateur_genre (masculin | feminin)
VOICE_GENDER=masculin
GEMINI_TTS_VOICE_M=Enceladus
GEMINI_TTS_VOICE_F=Kore
# Vitesse de lecture appliquée après synthèse
TTS_TEMPO=1.06

# ── Étape 3 : plan visuel (2.5_director_orchestrator.py) ────────────────────
MAX_PLANS_PER_SCENE=2

# ── Étape 4 : médias (2.7_media_fetcher.py → usine/media/) ──────────────────
# smart = archive réelle ou reconstitution selon le plan | real | generated
MEDIA_MIX_MODE=smart
# 1 = jamais d'image générée ni de stock (archives réelles uniquement)
REAL_MEDIA_ONLY=0
# 1 = validation Gemini sécurité + pertinence ; 0 = sécurité NSFW seule
STRICT_REAL_VALIDATION=1
# 1 = les sources curées sautent la validation de pertinence (pas la sécurité)
TRUST_CURATED_SOURCES=0
# 1 = ne pas réauditer le cache d'images existant
SKIP_CACHE_AUDIT=0
ALLOW_STOCK_FALLBACKS=0
ALLOW_PEXELS_VIDEO=0
ALLOW_POLLINATIONS_FALLBACK=1
FORCE_MONOCHROME_MEDIA=0
MAX_BING_RESULTS=24
MAX_DDG_RESULTS=36
MAX_DDG_QUERIES_PER_PLAN=3
DDG_TIMEOUT=6

# ── Étape 5 : rendu (3_render_hyperframes.py → usine/render/) ───────────────
# Style documentaire true crime par défaut (voir DESIGN.md)
USE_IMAGES=1
MOTION_STRENGTH=2.0
# Overlays documentaires déterministes (carte, année, dossier, compteur)
USE_SEMANTIC_OVERLAYS=1
# Director Agent Gemini : non déterministe, opt-in
USE_DIRECTOR_AGENT=0
USE_LOTTIE_OVERLAYS=0
USE_HOOK_INTRO=1
# Carte « HISTOIRE VRAIE » après le hook
SKIP_TRUTH_CARD=0
TRUTH_PREROLL_SECONDS=0.8
# CTA d'abonnement final + durée de queue après la voix
USE_OUTRO_CTA=1
OUTRO_TAIL_SECONDS=3.5
# Logo en haut à droite (chemin vide = assets/brand/logo_yurei.png)
USE_BRAND_LOGO=1
BRAND_LOGO_PATH=
# Bandeau d'accroche optionnel
USE_SCROLL_HOOK=0
SCROLL_HOOK_TEXT=CETTE AFFAIRE A DÉCLENCHÉ UNE VRAIE ENQUÊTE DE POLICE
# Tag « DOSSIER · ID » + couches HUD d'enquête (déconseillé par DESIGN.md)
USE_PERSISTENT_CASE_TAG=0
DISABLE_SCENE_TRANSITIONS=1
USE_ACT_GRADING=1
USE_FILM_GRAIN=1
USE_LETTERBOX=1
USE_BREATHING_VIGNETTE=1
USE_CHROMATIC_EMPH=0
# Sous-titres mot à mot via faster-whisper
USE_WHISPER_SYNC=1
MAX_SHOTS_PER_SCENE=4
MAX_SUB_CHUNKS=4
MAX_WORDS_PER_CHUNK=6

# ── Audio du rendu ──────────────────────────────────────────────────────────
USE_AMBIENT_MUSIC=1
AMBIENT_MUSIC_VOLUME=0.45
POST_MIX_MUSIC_VOLUME=0.28
USE_SYNTH_SFX=1
USE_WHOOSH_SFX=0
# Coupe musicale avant certains mots : "scène:mot,scène:mot"
USE_DRAMATIC_SILENCE=0
DRAMATIC_EVENT_SCENES=4:vide,9:disparu
TARGET_LUFS=-14.0

# ── Interne (posé automatiquement, ne pas définir) ──────────────────────────
# FORCE_PROJET  : projet courant, posé par batch_produce.py
# VISUAL_STYLE  : style visuel, posé par batch_produce.py depuis script.json
