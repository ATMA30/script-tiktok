# ── OBLIGATOIRES ──────────────────────────────────────────
# Gemini : génération du scénario, TTS (voix Enceladus) et Imagen 4
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONNELLES (fallbacks & API de stock) ───────────────
# Clés API pour la recherche d'images/vidéos réelles et d'illustration
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Jeton Hugging Face pour le téléchargement automatique des modèles Whisper
HF_TOKEN=your_hf_token_here

# ── UTILITAIRES INDÉPENDANTS (ElevenLabs) ─────────────────
# Paramètres pour l'utilitaire d'extraction de voix download_voice_sample.py
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ── RÉGLAGES AUDIO / TTS ──────────────────────────────────
# Ajustement du tempo de la voix (1.0 = normal, 1.06 = légèrement accéléré)
TTS_TEMPO=1.06

# ── PIPELINE MÉDIA (2.7_media_fetcher.py) ──────────────────
# Forcer uniquement l'utilisation de médias réels historiques (pas d'Imagen)
REAL_MEDIA_ONLY=0

# Mode de mixage média : "smart" (mélange IA / réel) ou "real"
MEDIA_MIX_MODE=smart

# Autoriser la recherche stock Pexels / Pixabay en cas d'échec d'Imagen
ALLOW_STOCK_FALLBACKS=0

# Autoriser le téléchargement de vidéos Pexels
ALLOW_PEXELS_VIDEO=0

# Autoriser le fallback Pollinations en cas d'échec d'Imagen
ALLOW_POLLINATIONS_FALLBACK=1

# Convertir tous les médias en noir & blanc pour le style True Crime / Docu
FORCE_MONOCHROME_MEDIA=1

# Limite de résultats de recherche Bing et DuckDuckGo
MAX_BING_RESULTS=24
MAX_DDG_RESULTS=36

# Validation stricte de la pertinence des images réelles téléchargées via Gemini
STRICT_REAL_VALIDATION=1

# ── MOTEUR DE RENDU VISUEL (3_render_hyperframes.py) ──────
# Rendu visuel global (1 = activé)
USE_IMAGES=1

# Temps de préchargement des images avant leur affichage (en secondes)
IMAGE_PRELOAD_LEAD_SECONDS=0.6

# Durée de la carte "TRUTH" d'intro
TRUTH_PREROLL_SECONDS=3.00

# Sauter la carte d'introduction
SKIP_TRUTH_CARD=0

# Utiliser l'accroche "hook" d'intro
USE_HOOK_INTRO=1

# Utiliser le Call To Action (CTA) de fin
USE_OUTRO_CTA=1

# Durée de l'outro (en secondes)
OUTRO_TAIL_SECONDS=3.5

# Utiliser des sous-titres dynamiques
USE_PUNCH_SUBTITLES=1

# Utiliser des effets sonores synthétisés
USE_SYNTH_SFX=1

# Utiliser la musique d'ambiance
USE_AMBIENT_MUSIC=1

# Volume de la musique d'ambiance (0.0 à 1.0)
AMBIENT_MUSIC_VOLUME=0.45

# Utiliser le color grading par acte (effet dramatique)
USE_ACT_GRADING=1

# Varier les transitions 3D entre les scènes
USE_VARIED_TRANSITIONS=1

# Désactiver toutes les transitions de scènes
DISABLE_SCENE_TRANSITIONS=0

# Appliquer un filtre grain de film vintage / VHS
USE_FILM_GRAIN=1

# Afficher l'étiquette rouge "CLASSIFIED"
USE_PERSISTENT_CASE_TAG=1

# Ajouter des bandes noires (Letterbox) cinématiques
USE_LETTERBOX=1

# Effet de vignettage dynamique (pulsation de stress)
USE_BREATHING_VIGNETTE=1

# Aberration chromatique sur les mots accentués
USE_CHROMATIC_EMPH=1

# Alignement mot-par-mot des sous-titres via Whisper
USE_WHISPER_SYNC=1

# Agents IA de composition (Legacy / Facultatif)
USE_SEMANTIC_OVERLAYS=0
USE_DIRECTOR_AGENT=0
USE_GENERATIVE_OVERLAYS=0
USE_AI_OVERLAY_DETECTION=0

# ══════════════════════════════════════════════════════════════════
#  PROFIL « SÉRIE DRAMATIQUE 1ʳᵉ PERSONNE »  (mode principal actuel)
#  Le contenu est de la FICTION → pas d'archives réelles à chercher,
#  images 100% générées, look couleur contemporain (pas le chrome
#  true-crime). Copie ces valeurs dans ton .env pour le rendu série.
# ══════════════════════════════════════════════════════════════════
# Modèle Gemini pour la génération du synopsis et des épisodes
SERIE_MODEL=gemini-2.5-flash

# Fiction → on génère les images (Imagen/Pollinations), on ne cherche AUCUNE archive réelle
# MEDIA_MIX_MODE=generated
# REAL_MEDIA_ONLY=0
# STRICT_REAL_VALIDATION=0
# Drame moderne en couleur (désactive le noir & blanc true-crime)
# FORCE_MONOCHROME_MEDIA=0
# Désactive le chrome documentaire/true-crime (étiquette CLASSIFIED, carte TRUTH)
# USE_PERSISTENT_CASE_TAG=0
# SKIP_TRUTH_CARD=1
